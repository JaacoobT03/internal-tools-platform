# Local development defaults only. Never reuse these values outside your machine.
# Copy to .env (optional: compose.yaml and the scripts fall back to these same defaults).

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432

# Used by Prisma/server when running on the host (not inside compose).
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
# Separate database for API tests (created by docker/postgres/init.sql).
TEST_DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_test

SERVER_PORT=3001
CLIENT_PORT=3000
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
