{
  "name": "internal-tools-platform",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm -r build",
    "test": "jest && pnpm -r test",
    "test:api": "pnpm --filter server test:api",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
