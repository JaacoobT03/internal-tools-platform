// Platform-owned models (ADR 0003, ADR 0004). Apps put their models in
// prisma/schema/<app>.prisma.

/// Append-only (ADR 0003). A database trigger rejects UPDATE, DELETE and
/// TRUNCATE on this table; see migration 20261018120000_platform_security.
model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([timestamp])
  @@map("audit_entry")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("approval_status")
}

/// Pending two-person approval (ADR 0004). Has no effect until approved.
model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  actionName  String         @map("action_name")
  payload     Json
  status      ApprovalStatus @default(pending)
  requestedBy String         @map("requested_by")
  decidedBy   String?        @map("decided_by")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt   DateTime?      @map("decided_at") @db.Timestamptz(3)

  @@index([status])
  @@map("approval_request")
}
